generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  phone           String?
  role            String   @default("TEACHER") // SUPER_ADMIN, ADMIN, TEACHER, PARENT
  status          String   @default("ACTIVE")  // ACTIVE, INACTIVE
  gender          String?  // MALE, FEMALE, OTHER
  address         String?
  avatar          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students        StudentGuardian[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@map("users")
}

// ==================== ACADEMIC STRUCTURE ====================

model SchoolClass {
  id              String   @id @default(cuid())
  name            String   // "Grade 1", "Nursery", etc.
  level           String   // PRE_NURSERY, NURSERY, PRIMARY, JUNIOR_SECONDARY
  stream          String?  // "A", "B", "C"
  teacherId       String?
  capacity        Int      @default(40)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students        Student[]
  feeStructures   FeeStructure[]
  exams           Exam[]
  attendances     Attendance[]

  @@map("classes")
}

model Subject {
  id              String   @id @default(cuid())
  name            String   // "Mathematics", "English", etc.
  code            String   @unique // "MATH", "ENG", etc.
  level           String   @default("PRIMARY") // PRE_PRIMARY, PRIMARY, JUNIOR_SECONDARY
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  examMarks       ExamMark[]

  @@map("subjects")
}

model Term {
  id              String   @id @default(cuid())
  name            String   // "Term 1", "Term 2", "Term 3"
  year            Int
  startDate       DateTime
  endDate         DateTime
  status          String   @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  feeStructures   FeeStructure[]
  exams           Exam[]
  attendances     Attendance[]

  @@map("terms")
}

// ==================== STUDENTS ====================

model Student {
  id              String   @id @default(cuid())
  admissionNumber String   @unique
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          String   // MALE, FEMALE
  classId         String
  stream          String?
  status          String   @default("ACTIVE") // ACTIVE, GRADUATED, TRANSFERRED, INACTIVE
  photo           String?
  address         String?
  medicalNotes    String?
  allergies       String?
  admissionDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class           SchoolClass @relation(fields: [classId], references: [id])
  guardians       StudentGuardian[]
  feeTransactions FeeTransaction[]
  examMarks       ExamMark[]
  attendances     Attendance[]

  @@map("students")
}

model StudentGuardian {
  id              String   @id @default(cuid())
  studentId       String
  guardianId      String   // References User table
  relationship    String   // FATHER, MOTHER, UNCLE, AUNT, GUARDIAN
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id])
  guardian        User     @relation(fields: [guardianId], references: [id])

  @@map("student_guardians")
}

// ==================== FEE MANAGEMENT ====================

model FeeStructure {
  id              String   @id @default(cuid())
  name            String   // "Term 1 Tuition", "Transport Fee"
  classId         String
  termId          String
  amount          Float
  category        String   @default("TUITION") // TUITION, TRANSPORT, BOARDING, EXTRACURRICULAR, OTHER
  description     String?
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  class           SchoolClass @relation(fields: [classId], references: [id])
  term            Term        @relation(fields: [termId], references: [id])
  transactions    FeeTransaction[]

  @@map("fee_structures")
}

model FeeTransaction {
  id              String   @id @default(cuid())
  studentId       String
  feeStructureId  String
  amount          Float
  paymentMethod   String   @default("CASH") // CASH, BANK, MPESA
  transactionRef  String?  // M-Pesa reference
  receiptNumber   String   @unique
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, REFUNDED
  term            String   // "2025-1" format
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         Student       @relation(fields: [studentId], references: [id])
  feeStructure    FeeStructure  @relation(fields: [feeStructureId], references: [id])

  @@map("fee_transactions")
}

// ==================== EXAMS & RESULTS ====================

model Exam {
  id              String   @id @default(cuid())
  name            String   // "Mid-Term Exam", "End of Term"
  termId          String
  classId         String
  type            String   @default("END_TERM") // CAT_1, CAT_2, END_TERM
  startDate       DateTime
  endDate         DateTime
  status          String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  totalMarks      Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  term            Term        @relation(fields: [termId], references: [id])
  class           SchoolClass @relation(fields: [classId], references: [id])
  marks           ExamMark[]

  @@map("exams")
}

model ExamMark {
  id              String   @id @default(cuid())
  examId          String
  studentId       String
  subjectId       String
  marks           Float
  grade           String?
  remarks         String?
  enteredBy       String?  // Teacher who entered marks
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exam            Exam    @relation(fields: [examId], references: [id])
  student         Student @relation(fields: [studentId], references: [id])
  subject         Subject @relation(fields: [subjectId], references: [id])

  @@map("exam_marks")
}

// ==================== ATTENDANCE ====================

model Attendance {
  id              String   @id @default(cuid())
  studentId       String
  classId         String
  termId          String
  date            DateTime
  status          String   @default("PRESENT") // PRESENT, ABSENT, LATE, EXCUSED
  reason          String?
  markedBy        String?  // Teacher who marked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         Student      @relation(fields: [studentId], references: [id])
  class           SchoolClass  @relation(fields: [classId], references: [id])
  term            Term         @relation(fields: [termId], references: [id])

  @@map("attendance")
}

// ==================== SYSTEM CONFIG ====================

model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

model SchoolNotice {
  id              String   @id @default(cuid())
  title           String
  content         String
  category        String   @default("GENERAL") // GENERAL, ACADEMIC, EVENTS, URGENT
  targetRoles     String   @default("ALL") // ALL, ADMIN, TEACHER, PARENT
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("school_notices")
}

// ==================== MESSAGING ====================

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  subject     String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@map("messages")
}

// ==================== CALENDAR ====================

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  startTime   String?  // e.g., "09:00"
  endTime     String?  // e.g., "10:30"
  location    String?
  eventType   String   @default("EVENT")  // EVENT, HOLIDAY, EXAM, MEETING, SPORTS, CULTURAL
  targetRoles String   @default("ALL")    // ALL, TEACHERS, PARENTS, STUDENTS, STAFF
  isAllDay    Boolean  @default(false)
  color       String   @default("teal")   // teal, amber, red, blue, purple, green
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("calendar_events")
}
